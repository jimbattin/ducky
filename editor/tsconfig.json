{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM"],
    "types": ["bun"]
  },
  "include": ["src", "../tools/*.ts"]
}
